<Window x:Class="MyMonitor.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyMonitor - Premium Portal" Height="680" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#07050E">

    <Grid>
        <!-- Background Ultra Dark Metallic Gradient -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#25123E" Offset="0.0"/>
                <GradientStop Color="#0F081D" Offset="0.6"/>
                <GradientStop Color="#050308" Offset="1.0"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Main Premium Glass Card -->
        <Border CornerRadius="30" Width="400" Margin="0,20,0,20" VerticalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2A1640" Offset="0.0"/>
                    <GradientStop Color="#140D28" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#408E2DE2" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1.5</Border.BorderThickness>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="#8E2DE2" Opacity="0.25" ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="25,20,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- PROFILE / AVATAR HEADER -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,15">
                    <Border Width="96" Height="96" CornerRadius="48" Padding="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0072FF" Offset="0.0"/>
                                <GradientStop Color="#FF00C6FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border CornerRadius="45" Background="#140D28">
                                <Border.Clip>
                                    <EllipseGeometry Center="45,45" RadiusX="45" RadiusY="45"/>
                                </Border.Clip>
                                <!-- Profile Image Source -->
                                <Image x:Name="imgProfile" 
                                       Source="Images/user_profile.png" 
                                       Stretch="UniformToFill"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- TAB CONTROL FOR LOGIN & REGISTER -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#8A8A9E"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Padding="20,10" Margin="5,0,5,15" CornerRadius="15" Background="#130B22">
                                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#4A00E0" Offset="0.0"/>
                                                            <GradientStop Color="#8E2DE2" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- LOGIN TAB -->
                    <TabItem Header="LOGIN">
                        <StackPanel Margin="5,10,5,5">

                            <!-- Username Input with Icon -->
                            <TextBlock Text="USER NAME" Foreground="#B0B0C8" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,5"/>
                            <Border Background="#100A1D" CornerRadius="12" BorderBrush="#30FFFFFF" BorderThickness="1" Height="42" Margin="0,0,0,18">
                                <Grid Margin="12,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- User Icon -->
                                    <Path Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="#8E2DE2" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    <TextBox x:Name="txtloginuser" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" CaretBrush="White"/>
                                </Grid>
                            </Border>

                            <!-- Password Input with Icon -->
                            <TextBlock Text="PASSWORD" Foreground="#B0B0C8" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,5"/>
                            <Border Background="#100A1D" CornerRadius="12" BorderBrush="#30FFFFFF" BorderThickness="1" Height="42" Margin="0,0,0,25">
                                <Grid Margin="12,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Lock Icon -->
                                    <Path Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="#8E2DE2" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                                    <PasswordBox x:Name="pwloginpassword" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" CaretBrush="White"/>
                                </Grid>
                            </Border>

                            <!-- Luxury Login Button -->
                            <Button Content="LOG IN" Click="btnlogin_Click" Height="45" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Margin="0,10,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="22" x:Name="btnBorder">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#00C6FF" Offset="0.0"/>
                                                                <GradientStop Color="#0072FF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="15" Color="#0072FF" Opacity="0.4" ShadowDepth="3"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </TabItem>

                    <!-- REGISTER TAB -->
                    <TabItem Header="REGISTER">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5,5,5,5">

                                <!-- Username -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="USER NAME" Foreground="#B0B0C8" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#FF4D4D" FontSize="11"/>
                                </StackPanel>
                                <Border Background="#100A1D" CornerRadius="10" BorderBrush="#30FFFFFF" BorderThickness="1" Height="38" Margin="0,4,0,2">
                                    <Grid Margin="10,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" VerticalAlignment="Center" Fill="#00C6FF" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                        <TextBox x:Name="txtreguser" Grid.Column="1" MaxLength="10" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="White"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="erruser" Foreground="#FF5555" FontSize="10" Margin="2,0,0,6"/>

                                <!-- Password -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PASSWORD" Foreground="#B0B0C8" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#FF4D4D" FontSize="11"/>
                                </StackPanel>
                                <Border Background="#100A1D" CornerRadius="10" BorderBrush="#30FFFFFF" BorderThickness="1" Height="38" Margin="0,4,0,2">
                                    <Grid Margin="10,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" VerticalAlignment="Center" Fill="#00C6FF" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                                        <PasswordBox x:Name="pwregpassword" Grid.Column="1" MaxLength="10" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="White"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="errpassword" Foreground="#FF5555" FontSize="10" Margin="2,0,0,6"/>

                                <!-- Age -->
                                <TextBlock Text="AGE" Foreground="#B0B0C8" FontSize="11" FontWeight="SemiBold"/>
                                <Border Background="#100A1D" CornerRadius="10" BorderBrush="#30FFFFFF" BorderThickness="1" Height="38" Margin="0,4,0,2">
                                    <Grid Margin="10,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Age Icon -->
                                        <Path Grid.Column="0" VerticalAlignment="Center" Fill="#00C6FF" Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/>
                                        <TextBox x:Name="txtage" Grid.Column="1" MaxLength="3" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="White"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="errage" Foreground="#FF5555" FontSize="10" Margin="2,0,0,6"/>

                                <!-- Email -->
                                <TextBlock Text="EMAIL" Foreground="#B0B0C8" FontSize="11" FontWeight="SemiBold"/>
                                <Border Background="#100A1D" CornerRadius="10" BorderBrush="#30FFFFFF" BorderThickness="1" Height="38" Margin="0,4,0,2">
                                    <Grid Margin="10,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Email Icon -->
                                        <Path Grid.Column="0" VerticalAlignment="Center" Fill="#00C6FF" Data="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                                        <TextBox x:Name="txtemail" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="White"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="erremail" Foreground="#FF5555" FontSize="10" Margin="2,0,0,12"/>

                                <!-- Luxury Register Button -->
                                <Button Content="CREATE ACCOUNT" Click="btnreg_Click" Height="42" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="21">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#4A00E0" Offset="0.0"/>
                                                                    <GradientStop Color="#8E2DE2" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="15" Color="#8E2DE2" Opacity="0.4" ShadowDepth="3"/>
                                                            </Border.Effect>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>